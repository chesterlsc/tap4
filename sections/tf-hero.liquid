{%- comment -%}
  Hero "1b": the TAP4.1 L-Stand offer up front — three faces, a finish switch and the selected offer.
  Selection, photos and prices are driven by theme.js and shared with the setup builder below.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign faces = 'review|QUICK START|Review|₱899;menu|BEST FOR CAFÉS|Review + Menu|₱1,398;links|GROW FOLLOWERS|4-in-1|₱1,249' | split: ';'
-%}
<section class="hero hero--tap4" data-hero>
  <div class="glow hero__glow1"></div>
  <div class="hero__in">
    <div class="h4">
      <div class="h4__copy">
        <div class="chips">
          <div class="chip chip--g"><svg class="chip__g" style="fill:#4285F4"><use href="#i-google"/></svg><span class="stars">★★★★★</span>{{ s.chip_1 | escape }}</div>
          <div class="chip chip--lime"><span style="font-size:12px">↑</span>{{ s.chip_2 | escape }}</div>
        </div>
        <h1 class="hero__title">{{ s.title_1 | escape }}<br><span>{{ s.title_2 | escape }}</span></h1>
        <p class="hero__sub">{{ s.subtitle | escape }}</p>
      </div>

      <div class="h4__stage">
        <div class="h4__faces" data-hero-faces>
          {%- for f in faces -%}
            {%- assign p = f | split: '|' -%}
            <button type="button" class="h4-face{% if p[0] == 'menu' %} on{% endif %}" data-act="heroFace" data-arg="{{ p[0] }}" aria-pressed="{% if p[0] == 'menu' %}true{% else %}false{% endif %}">
              <img src="{{ 'tapfour-l-black-' | append: p[0] | append: '.jpg' | asset_url }}" alt="TAP4.1 L-Stand, {{ p[2] }} face" width="1122" height="1402" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" data-face-img>
              <span class="h4-face__tag">{{ p[1] }}</span>
              <span class="h4-face__foot"><span><b>{{ p[2] }}</b><em data-face-price>{{ p[3] }}</em></span><i class="h4-face__dot">{% if p[0] == 'menu' %}✓{% else %}→{% endif %}</i></span>
            </button>
          {%- endfor -%}
        </div>
        <div class="h4__dots" aria-hidden="true"><i></i><i class="on"></i><i></i></div>
        <div class="seg h4__finish" role="group" aria-label="Finish">
          <button type="button" class="on" data-act="finish" data-arg="black">Glossy Black</button>
          <button type="button" data-act="finish" data-arg="white">Glossy White</button>
        </div>
      </div>

      <div class="h4__offer">
        <div class="h4-offer__body">
          <div class="h4-offer__top">
            <div><span class="h4-offer__lbl">SELECTED</span><b data-offer-name>Review + Menu</b></div>
            <div class="h4-offer__price"><b data-offer-now>₱1,398</b><s data-offer-was>₱2,328</s></div>
          </div>
          <p data-offer-desc>Tap to review, scan the QR for your menu.</p>
          <button type="button" class="btn btn--lime btn--block h4-offer__cta" data-act="heroOrder" data-offer-cta>Order Review + Menu →</button>
          <div class="h4-offer__checks"><span><i>✓</i>Free shipping</span><span><i>✓</i>One-time price</span><span><i>✓</i>Works without an app</span></div>
        </div>
        <a class="h4-offer__app" href="#plans">{% render 'tf-mark', px: 18 %}<span><small>{{ s.teaser }}</small><b>{{ s.teaser_link | escape }}</b></span><i>→</i></a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "More good reviews" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Rank higher on Google Maps" },
    { "type": "text", "id": "title_1", "label": "Title line 1", "default": "Pick a stand." },
    { "type": "text", "id": "title_2", "label": "Title line 2 (lime)", "default": "Get reviewed." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "An NFC stand in glossy acrylic, with three faces for every counter. Each one is programmed to your links and ready out of the box." },
    { "type": "text", "id": "teaser", "label": "App teaser", "default": "Table orders & guest data?" },
    { "type": "text", "id": "teaser_link", "label": "App teaser link text", "default": "tapfour app from ₱299/mo" }
  ],
  "presets": [{ "name": "Tapfour hero" }]
}
{% endschema %}
