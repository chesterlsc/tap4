{%- comment -%}
  Hero "2a · the map climb": the result (a Maps-style list where your shop climbs, before / with tapfour)
  and the one stand that gets it. Face, finish, photo and price are driven by theme.js and shared with the builder.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="hero hero--map" data-hero>
  <div class="glow hero__glow1"></div>
  <div class="hero__in">
    <div class="hm">
      <div class="hm__copy">
        <div class="hm__chips">
          <span class="hm-chip"><span class="hm-g"><svg width="12" height="12" style="fill:#4285F4" aria-hidden="true"><use href="#i-google"/></svg></span><span class="hm-stars">★★★★★</span>{{ s.chip_1 | escape }}</span>
          <span class="hm-chip hm-chip--lime"><i class="hm-pin" aria-hidden="true"><i></i></i>{{ s.chip_2 | escape }}</span>
        </div>
        <h1 class="hm__t">{{ s.title_1 | escape }}<br><span>{{ s.title_2 | escape }}</span></h1>
        <p class="hm__p hm-d">{{ s.subtitle | escape }}</p>
        <div class="hm__cta hm-d"><button type="button" class="btn btn--lime hm-cta" data-act="heroOrder" data-hero-cta>Get this stand →</button><a class="hm-cta2" href="#app">{{ s.cta2 | escape }}</a></div>
      </div>

      <div class="hm-map">
        <div class="hm-map__q"><i class="hm-pin" aria-hidden="true"><i></i></i>{{ s.search | escape }}</div>
        <div class="hm-map__list" data-hero-ranks></div>
        <div class="hm-map__f">
          <small>ILLUSTRATION ONLY</small>
          <div class="hm-ba" role="group" aria-label="Map ranking"><button type="button" data-act="heroBa" data-arg="0">Before</button><button type="button" class="on" data-act="heroBa" data-arg="1">With tapfour</button></div>
        </div>
      </div>

      <p class="hm__p hm-m">{{ s.subtitle | escape }}</p>

      <div class="hm-stand">
        <div class="hm-card">
          <img src="{{ 'tapfour-l-black-menu.jpg' | asset_url }}" alt="tapfour NFC Google review stand with QR menu (TAP4.1 L-Stand, glossy black)" width="1122" height="1402" fetchpriority="high" data-hero-img>
          <span class="hm-card__tag" data-hero-tag>BEST SELLER · GLOSSY BLACK</span>
          <div class="hm-card__info"><b data-hero-name>Review + QR menu stand</b><span data-hero-sub>Tap to review · scan for your menu</span><b class="hm-card__p"><span data-hero-now>₱1,398</span> <s data-hero-was></s></b></div>
        </div>
        <div class="hm-seg hm-seg--3" role="group" aria-label="Stand face">
          <button type="button" class="on" data-act="heroFace" data-arg="menu">Review + QR</button>
          <button type="button" data-act="heroFace" data-arg="review">Review</button>
          <button type="button" data-act="heroFace" data-arg="links">4-in-1</button>
        </div>
        <div class="hm-seg hm-seg--2" role="group" aria-label="Finish">
          <button type="button" class="on" data-act="finish" data-arg="black">Black</button>
          <button type="button" data-act="finish" data-arg="white">White</button>
        </div>
      </div>

      <div class="hm__cta hm-m"><button type="button" class="btn btn--lime hm-cta" data-act="heroOrder" data-hero-cta>Get this stand →</button></div>
    </div>

    <div class="hm-solo">
      <span class="hm-solo__t"><span class="hm-solo__k">{% render 'tf-mark', px: 18 %}SOLO PACKAGE</span><b>5 stands + the tapfour app</b></span>
      <span class="hm-solo__chips"><em>Live menu</em><em>Dashboard</em><em>Inventory &amp; billing tracking</em><em>Tap-to-join Wi-Fi</em><em>Edit links anytime</em></span>
      <span class="hm-solo__p"><b data-solo-up>₱3,000</b><small data-solo-mo>+ ₱299/mo</small></span>
      <button type="button" class="hm-solo__cta" data-act="planCta" data-arg="solo">Get Solo →</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "More good reviews" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Higher ranking on Google Maps" },
    { "type": "text", "id": "title_1", "label": "Title line 1", "default": "Climb the map." },
    { "type": "text", "id": "title_2", "label": "Title line 2 (lime)", "default": "Fill the tables." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "A one-star rise in rating can lift restaurant revenue by 5–⁠9% (Harvard Business School). The tapfour NFC stand puts your Google review one tap away for every happy guest." },
    { "type": "text", "id": "cta2", "label": "Second button", "default": "See the tapfour app ↓" },
    { "type": "text", "id": "search", "label": "Map search text", "default": "coffee near me" }
  ],
  "presets": [{ "name": "Tapfour hero" }]
}
{% endschema %}
