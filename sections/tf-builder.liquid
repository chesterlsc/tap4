<section id="build" class="sec" data-builder>
  <div class="sec__head">
    <div class="sec__titles">
      <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
      <h2 class="h2">{{ section.settings.title | escape }}</h2>
    </div>
    <div class="bld-trust mono-12"><span>✓ FREE SHIPPING</span><span>✓ PAY ONCE</span><span>✓ NO APP FOR GUESTS</span></div>
  </div>

  <div class="bld">
    <div class="bld-pv" id="tf-preview"></div>

    <div class="stack-14">
      <div class="step step--pkg" id="tf-pkg" hidden></div>

      <div class="step" id="tf-step-stand">
        <div class="step__h"><span class="step__n">1</span><b>Choose a stand</b><em>GLOSSY ACRYLIC · NFC</em></div>
        <div class="bld-2" id="tf-stands"></div>
      </div>

      <div class="step" id="tf-step-face">
        <div class="step__h"><span class="step__n">2</span><b id="tf-face-title">Pick the face</b><em id="tf-face-tag"></em></div>
        <div id="tf-faces"></div>
      </div>

      <div class="step">
        <div class="step__h"><span class="step__n" id="tf-n-fin">3</span><b id="tf-fin-title">Finish &amp; quantity</b></div>
        <div class="row-between wrap">
          <div class="bld-fin" id="tf-finish" role="group" aria-label="Finish"></div>
          <div class="qty" id="tf-qty-wrap">
            <button type="button" data-act="qty" data-arg="-1" aria-label="Decrease quantity">−</button>
            <output id="tf-qty">1</output>
            <button type="button" class="on" data-act="qty" data-arg="1" aria-label="Increase quantity">+</button>
          </div>
        </div>
      </div>

      <div class="step">
        <div class="step__h"><span class="step__n" id="tf-n-links">4</span><b>Your links</b><em>WE PROGRAM THESE</em></div>
        <label class="lf"><span class="lf__h"><span>Business name</span><em>For your order · not printed</em></span><input id="tf-name" maxlength="40" autocomplete="organization" placeholder="e.g. Kape Norte"></label>
        <div class="stack-14" id="tf-links"></div>
      </div>

      <div class="step" id="tf-extra"></div>

      <div class="sum" id="tf-summary"></div>
    </div>
  </div>
  <div class="order-bar" id="tf-bar" aria-hidden="true">
    <div class="order-bar__sum"><span>YOUR SETUP</span><b id="tf-bar-total"></b></div>
    <button type="button" class="btn btn--lime" data-to-summary tabindex="-1">Checkout →</button>
  </div>
  <div class="co co--pop" id="tf-app" hidden>
    <div class="co__scrim" data-app-close></div>
    <div class="co__panel" role="dialog" aria-modal="true" aria-labelledby="app-title"></div>
  </div>
  <div class="co" id="tf-checkout" hidden>
    <div class="co__scrim" data-co-close></div>
    <div class="co__panel" role="dialog" aria-modal="true" aria-labelledby="co-title"></div>
  </div>
</section>

{% schema %}
{
  "name": "Setup builder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 — BUILD YOUR SETUP" },
    { "type": "text", "id": "title", "label": "Title", "default": "Four choices. We program it and ship." }
  ],
  "presets": [{ "name": "Setup builder" }]
}
{% endschema %}
