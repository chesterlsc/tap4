{%- comment -%}
  About us: page heading + intro, a row of principles (blocks), the product in one line, and a contact CTA.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="sec about" aria-labelledby="about-t">
  <div class="sec__titles about__head">
    <div class="eyebrow">{{ s.eyebrow | escape }}</div>
    <h1 class="h2" id="about-t">{{ s.title | escape }}</h1>
    {%- if s.intro != blank -%}<div class="about__intro">{{ s.intro }}</div>{%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="about__grid">
      {%- for block in section.blocks -%}
        <div class="about__card" {{ block.shopify_attributes }}>
          <b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b>
          <h2>{{ block.settings.title | escape }}</h2>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="about__cta">
    <div>
      <h2 class="about__cta-t">{{ s.cta_title | escape }}</h2>
      <p>{{ s.cta_text | escape }}</p>
    </div>
    <div class="about__btns">
      <a class="btn btn--lime btn--lg" href="/#build">{{ s.cta_label | escape }}</a>
      <a class="btn btn--ghost btn--lg" href="mailto:{{ s.email | escape }}">{{ s.email | escape }}</a>
    </div>
  </div>
</section>

<style>
  .about { gap: 56px; }
  .about__head .h2 { max-width: 900px; }
  .about__intro { max-width: 760px; font-size: 20px; line-height: 1.55; color: var(--m2); }
  .about__intro p + p { margin-top: 14px; }
  .about__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .about__card { display: flex; flex-direction: column; gap: 10px; padding: 26px; border-radius: 24px; background: var(--card); box-shadow: inset 0 0 0 1px var(--l2); }
  .about__card b { font: 500 13px var(--mono); letter-spacing: .06em; color: var(--lime); }
  .about__card h2 { font-size: 22px; font-weight: 700; letter-spacing: -.035em; line-height: 1.15; margin-top: 4px; }
  .about__card p { font-size: 15.5px; line-height: 1.5; color: var(--m3); }
  .about__cta { display: flex; justify-content: space-between; align-items: center; gap: 28px; flex-wrap: wrap; padding: 36px 40px; border-radius: 28px; background: var(--card); box-shadow: inset 0 0 0 1px var(--l2); }
  .about__cta-t { font-size: clamp(26px, 3vw, 36px); font-weight: 700; letter-spacing: -.045em; line-height: 1.05; }
  .about__cta p { margin-top: 8px; color: var(--m3); font-size: 16px; }
  .about__btns { display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 1100px) { .about__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .about { gap: 36px; }
    .about__intro { font-size: 16px; }
    .about__grid { grid-template-columns: 1fr; }
    .about__card { padding: 22px; border-radius: 20px; }
    .about__cta { padding: 26px 22px; border-radius: 22px; }
    .about__btns, .about__btns .btn { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "About us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ABOUT US" },
    { "type": "text", "id": "title", "label": "Title", "default": "One tap between a happy guest and your next review." },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "cta_title", "label": "Call to action title", "default": "Ready when you are." },
    { "type": "text", "id": "cta_text", "label": "Call to action text", "default": "Build your setup in a minute, or email us with any question." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Build your setup →" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@tapfour.ph" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Principle",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "About us" }]
}
{% endschema %}
