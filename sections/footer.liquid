<footer class="site-footer">
  <div class="site-footer__in">
    <a class="site-footer__brand" href="{{ routes.root_url }}">{{ section.settings.brand | default: shop.name | escape }}</a>
    {%- assign menu = section.settings.menu -%}
    <nav class="site-footer__nav" aria-label="Footer">
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
      {%- else -%}
        <a href="/#build">Review stands</a><a href="/#app">QR menu</a><a href="/#plans">Pricing</a><a href="/#services">Services</a>
      {%- endif -%}
    </nav>
    <span>{{ section.settings.text | escape }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand name", "default": "tapfour" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
    { "type": "text", "id": "text", "label": "Text", "default": "Made in the Philippines · hello@tapfour.ph" }
  ]
}
{% endschema %}
