{%- paginate collection.products by 24 -%}
<section class="sec sec--tight">
  <div class="sec__titles">
    <div class="eyebrow">COLLECTION</div>
    <h1 class="h2">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank %}<div class="sec__lead rte">{{ collection.description }}</div>{% endif -%}
  </div>
  <div class="p-grid">
    {%- for product in collection.products -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      <p class="m3">No products yet.</p>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 %}<nav class="pager">{{ paginate | default_pagination }}</nav>{% endif -%}
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
