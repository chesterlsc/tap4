{%- comment -%}
  FAQ: questions as native <details> (no JS). On the FAQ page, "schema" adds FAQPage structured data for Google;
  leave it off on the homepage copy so the same questions aren't marked up twice.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section id="faq" class="sec faq" aria-labelledby="faq-t-{{ section.id }}">
  <div class="faq__grid">
    <div class="sec__titles faq__head">
      <div class="eyebrow">{{ s.eyebrow | escape }}</div>
      {%- if s.h1 -%}
        <h1 class="h2" id="faq-t-{{ section.id }}">{{ s.title | escape }}</h1>
      {%- else -%}
        <h2 class="h2" id="faq-t-{{ section.id }}">{{ s.title | escape }}</h2>
      {%- endif -%}
      {%- if s.intro != blank -%}<p class="sec__lead">{{ s.intro | escape }}</p>{%- endif -%}
      {%- if s.link_label != blank -%}<a class="faq__more" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__q" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.q | escape }}</span><i aria-hidden="true"></i></summary>
          <div class="faq__a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if s.schema and section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | strip | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<style>
  .faq__grid { display: grid; grid-template-columns: minmax(0, 380px) minmax(0, 1fr); gap: 56px; align-items: start; }
  .faq__head { position: sticky; top: 110px; }
  .faq__more { margin-top: 10px; font: 500 13px var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--lime); }
  .faq__more:hover { text-decoration: underline; }
  .faq__list { display: flex; flex-direction: column; border-top: 1px solid var(--l2); }
  .faq__q { border-bottom: 1px solid var(--l2); }
  .faq__q summary { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 22px 4px; cursor: pointer; list-style: none; font-size: 19px; font-weight: 600; letter-spacing: -.02em; line-height: 1.3; }
  .faq__q summary::-webkit-details-marker { display: none; }
  .faq__q summary:hover { color: var(--lime); }
  .faq__q summary i { position: relative; flex: none; width: 14px; height: 14px; }
  .faq__q summary i::before, .faq__q summary i::after { content: ""; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; border-radius: 2px; background: currentColor; transition: transform .25s cubic-bezier(.2,.8,.2,1); }
  .faq__q summary i::after { transform: rotate(90deg); }
  .faq__q[open] summary i::after { transform: rotate(0deg); }
  .faq__a { padding: 0 4px 24px; max-width: 720px; font-size: 16px; line-height: 1.6; color: var(--m2); }
  .faq__a p + p { margin-top: 10px; }
  .faq__a a { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) {
    .faq__grid { grid-template-columns: 1fr; gap: 24px; }
    .faq__head { position: static; }
    .faq__q summary { font-size: 17px; padding: 18px 2px; }
    .faq__a { font-size: 15px; }
  }
</style>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "title", "label": "Title", "default": "Questions, answered." },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "text", "id": "link_url", "label": "Link URL", "default": "/pages/faq" },
    { "type": "checkbox", "id": "h1", "label": "Title is the page heading (H1)", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ structured data (use on one page only)", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "q", "label": "Question" },
        { "type": "richtext", "id": "a", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
