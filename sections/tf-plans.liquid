{%- comment -%}
  03 · Dashboard & plans (1b v2). Each plan is a package: stands paid once plus the app monthly.
  App prices come from the tapfour-app "<Plan> / Monthly" and "<Plan> / Yearly" variants; package prices from the
  tapfour-package "<Plan>" variant (theme.js). Block fallbacks show until those products exist.
  The dashboard, floor and table-ordering phones are rendered by theme.js from sample data.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign app = s.product
-%}
<section id="plans" class="sec dp" data-plans>
  <div class="sec__head">
    <div class="sec__titles">
      <div class="eyebrow">{{ s.eyebrow | escape }}</div>
      <h2 class="h2">{{ s.title_1 | escape }}<br>{{ s.title_2 | escape }}</h2>
    </div>
    <div class="seg">
      <button type="button" class="on" data-act="yearly" data-arg="0">Monthly</button>
      <button type="button" data-act="yearly" data-arg="1">Yearly −20%</button>
    </div>
  </div>

  <div class="dp__grid">
    <div class="dp__side">
      <div class="dp-loc">
        <span class="mono-11 m3">LOCATIONS</span>
        <div class="dp-loc__n"><b data-dp-n>1</b><span data-dp-word>location</span></div>
        <input type="range" min="0" max="8" step="1" value="0" data-dp-range aria-label="Number of locations">
        <div class="dp-zones" aria-hidden="true"><i data-z="0"></i><i data-z="1"></i><i data-z="2"></i></div>
        <div class="dp-zones__l"><span data-z="0">SOLO · 1</span><span data-z="1">BUSINESS · 2–5</span><span data-z="2">EMPIRE · 6–20</span></div>
      </div>
      {%- for block in section.blocks -%}
      {%- liquid
        assign name = block.settings.name
        assign m_title = name | append: ' / Monthly'
        assign y_title = name | append: ' / Yearly'
        assign vm = app.variants | where: 'title', m_title | first
        assign vy = app.variants | where: 'title', y_title | first
        if vm
          assign pm = vm.price | divided_by: 100.0
          assign plan_count = 0
          for allocation in vm.selling_plan_allocations
            if allocation.selling_plan.recurring_deliveries
              assign plan_count = plan_count | plus: 1
              assign pm = allocation.price | divided_by: 100.0
            endif
          endfor
          if plan_count != 1
            assign pm = vm.price | divided_by: 100.0
          endif
        else
          assign pm = block.settings.price
        endif
        if vy
          assign py = vy.price | divided_by: 1200.0
          assign plan_count = 0
          for allocation in vy.selling_plan_allocations
            if allocation.selling_plan.recurring_deliveries
              assign plan_count = plan_count | plus: 1
              assign py = allocation.price | divided_by: 1200.0
            endif
          endfor
          if plan_count != 1
            assign py = vy.price | divided_by: 1200.0
          endif
        else
          assign py = block.settings.price | times: 0.8
        endif
      -%}
        <div class="dp-plan" data-plan="{{ name | handleize }}" data-m="{{ pm }}" data-y="{{ py }}" data-up="{{ block.settings.package_price }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="dp-plan__h"><h3>{{ name | escape }}</h3><span>{{ block.settings.tag | escape }}</span></div>
          <div class="dp-plan__pkg">
            <small>PACKAGE · ONE-TIME</small>
            <b data-plan-up>{{ block.settings.package_price | times: 100 | money_without_trailing_zeros }}</b>
            <span class="dp-plan__hw"><b>✓</b>{{ block.settings.package_hw | escape }}</span>
          </div>
          <div class="dp-plan__app">
            <div class="dp-plan__apph"><small>APP · MONTHLY</small><span><b data-plan-price>+ {{ pm | times: 100 | money_without_trailing_zeros }}</b>/mo</span></div>
            <ul>{% assign items = block.settings.features | newline_to_br | split: '<br />' %}{% for i in items %}{% assign i = i | strip %}{% if i != '' %}<li>{{ i | escape }}</li>{% endif %}{% endfor %}</ul>
          </div>
          <div class="dp-add">
            <div class="dp-add__h"><span><small>ADD-ON</small><b>Order from the table</b></span><button type="button" data-act="pkgOrder" aria-pressed="false">+ Add</button></div>
            <div class="dp-add__flow"><span>Guest</span><i>→</i><span>Your server</span><i>→</i><span>Kitchen</span></div>
            <div class="dp-add__f"><small>PRICED BY TABLES &amp; VOLUME</small><b>from ₱499/mo</b></div>
          </div>
          <div class="dp-plan__tot"><span data-plan-billing>MONTHLY · BILLED MONTHLY</span><b data-plan-total></b></div>
          <button type="button" class="dp-plan__cta" data-act="planCta" data-arg="{{ name | handleize }}">Choose {{ name | escape }} →</button>
        </div>
      {%- endfor -%}
    </div>

    <div class="dp-dash" aria-label="Sample tapfour dashboard">
      <div class="dp-dash__nav">
        <div class="dp-dash__logo">{% render 'tf-mark', px: 16 %}<b>tapfour</b></div>
        <div data-dp-nav></div>
      </div>
      <div class="dp-dash__main">
        <div class="dp-dash__h"><b data-dp-view>My stands</b><span class="mono-11 m3" data-dp-scope>SAMPLE DATA · YOUR SHOP</span></div>
        <div class="dp-view" data-dp-body></div>
      </div>
    </div>
  </div>

  <div class="dp-to" id="table-ordering">
    <div class="dp-to__head">
      <div class="dp-to__titles"><div class="eyebrow">ADD-ON · TABLE ORDERING</div><h3>Guests order from the table.<br>Your server gets it on their phone.</h3></div>
      <div class="dp-to__from"><small>STARTS AT</small><span><b>₱499</b>/mo</span></div>
    </div>
    <div class="dp-to__demo">
      <div class="dp-to__col"><small>GUEST’S PHONE</small><div class="dp-ph"><div class="dp-ph__s dp-ph__s--light" data-to-guest></div></div></div>
      <div class="dp-to__steps">
        <div class="dp-step"><span>1</span><div><b>Guest scans the table QR</b><p>The menu opens on their phone. No app to download, no account.</p></div></div>
        <div class="dp-step"><span>2</span><div><b>They tap “Send to server”</b><p>Items, table number and notes go straight to your server’s phone.</p></div></div>
        <div class="dp-step"><span>3</span><div><b>Your server confirms and serves</b><p>One tap sends it to the kitchen. Another marks it served.</p></div></div>
        <div class="bld-ok">Refills, “Call server” and “Bill please” go the same way, so unli and samgyupsal tables don’t have to wave anyone down.</div>
      </div>
      <div class="dp-to__col"><small>SERVER’S PHONE</small><div class="dp-ph"><div class="dp-ph__s" data-to-server></div></div></div>
    </div>
    <div class="dp-to__quote">
      <div class="dp-to__q">
        <div class="dp-to__qh"><b>Your price depends on your place.</b><p>From ₱499/mo. Tell us how many tables you have, what you serve and how busy it gets, and we’ll send your price.</p></div>
        <div class="stack-14" data-to-groups></div>
      </div>
      <div class="dp-to__place"><small>YOUR PLACE</small><span data-to-place></span><button type="button" class="btn btn--lime" data-to-quote>Get my price →</button></div>
    </div>
  </div>

  <div class="dp__foot mono-12"><span>SAMPLE DATA · DASHBOARD.TAP4.PH</span><span>CANCEL ANYTIME — TAPS NEVER CHECK YOUR PLAN</span></div>
</section>

{% schema %}
{
  "name": "Dashboard & plans",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 — DASHBOARD & PLANS" },
    { "type": "text", "id": "title_1", "label": "Title line 1", "default": "How many shops" },
    { "type": "text", "id": "title_2", "label": "Title line 2", "default": "do you run?" },
    { "type": "product", "id": "product", "label": "App product", "info": "Variants named \"<Plan> / Monthly\" and \"<Plan> / Yearly\"." }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "name", "label": "Name (matches variant option)", "default": "Solo" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "1 LOCATION" },
        { "type": "textarea", "id": "features", "label": "App features (one per line)" },
        { "type": "number", "id": "price", "label": "Fallback monthly price", "default": 299 },
        { "type": "number", "id": "package_price", "label": "Package price (one-time)", "default": 3000 },
        { "type": "text", "id": "package_hw", "label": "Package hardware", "default": "5 Review + Menu stands" }
      ]
    }
  ],
  "presets": [{ "name": "Plans" }]
}
{% endschema %}
