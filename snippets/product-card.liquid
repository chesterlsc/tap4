<a class="p-card" href="{{ product.url }}">
  <div class="p-card__media">
    {%- if product.featured_media -%}
      {%- assign media_alt = product.featured_media.alt | default: product.title -%}
      {{ product.featured_media.preview_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 100vw', widths: '400,600,800', alt: media_alt }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'p-card__ph' }}
    {%- endif -%}
    {%- if product.compare_at_price > product.price -%}<span class="tag tag--lime p-card__tag">SALE</span>{%- endif -%}
  </div>
  <div class="p-card__body">
    <div class="p-card__title">{{ product.title | escape }}</div>
    {% render 'price', product: product %}
  </div>
</a>
