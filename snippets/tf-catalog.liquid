{%- comment -%}
  Prices + variant ids the builder, plans and services read from.
  all_products allows 20 unique handles per page; this uses 13.
  Recurring variants need exactly one applicable recurring selling plan.
{%- endcomment -%}
{%- liquid
  assign handles = 'tap4-l-stand,4-tap-bar,printed-qr-menu,multi-link-page,tapfour-app,tapfour-app-add-ons,page-build,menu-setup,google-profile-setup,custom-stand-design,social-starter-pack,managed-dashboard,reseller-starter-kit' | split: ','
-%}
<script>
  window.TF = {
    cartUrl: {{ routes.cart_url | json }},
    cartAddUrl: {{ routes.cart_add_url | append: '.js' | json }},
    menuUploadUrl: {{ settings.menu_upload_url | json | replace: '<', '\u003c' }},
    orderEmail: {{ settings.order_email | json | replace: '<', '\u003c' }},
    currency: {{ cart.currency.iso_code | default: 'PHP' | json }},
    sale: {
      end: {{ settings.sale_end | json | replace: '<', '\u003c' }},
      stock: {{ settings.sale_stock | default: 0 }},
      label: {{ settings.sale_label | json | replace: '<', '\u003c' }}
    },
    img: {
      "l-black-review": {{ 'tapfour-l-black-review.jpg' | asset_url | json }},
      "l-black-menu": {{ 'tapfour-l-black-menu.jpg' | asset_url | json }},
      "l-black-links": {{ 'tapfour-l-black-links.jpg' | asset_url | json }},
      "l-white-review": {{ 'tapfour-l-white-review.jpg' | asset_url | json }},
      "l-white-menu": {{ 'tapfour-l-white-menu.jpg' | asset_url | json }},
      "l-white-links": {{ 'tapfour-l-white-links.jpg' | asset_url | json }},
      bar4tap: {{ 'bar-4tap.jpg' | asset_url | json }}
    },
    products: {
      {%- for h in handles -%}
        {%- assign p = all_products[h] -%}
        {{ h | json }}: {% if p.id %}{"title": {{ p.title | json | replace: '<', '\u003c' }}, "variants": [
          {%- for v in p.variants -%}
            {%- liquid
              assign recurring_count = 0
              assign plan_id = 'null'
              assign unit_price = v.price
              if p.tags contains 'subscription' or p.tags contains 'monthly'
                for allocation in v.selling_plan_allocations
                  if allocation.selling_plan.recurring_deliveries
                    assign recurring_count = recurring_count | plus: 1
                    assign plan_id = allocation.selling_plan.id
                    assign unit_price = allocation.price
                  endif
                endfor
                if recurring_count != 1
                  assign plan_id = 'null'
                  assign unit_price = v.price
                endif
              endif
            -%}
            {"id": {{ v.id }}, "title": {{ v.title | json | replace: '<', '\u003c' }}, "price": {{ unit_price }}, "compare": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available }}, "sp": {{ plan_id }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  };
</script>
