<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0a0a0b">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- liquid
    if template.name == 'index' and settings.seo_home_title != blank
      assign seo_title = settings.seo_home_title
    else
      assign seo_title = page_title
      if current_page != 1
        assign seo_title = seo_title | append: ' – Page ' | append: current_page
      endif
      unless seo_title contains shop.name
        assign seo_title = seo_title | append: ' – ' | append: shop.name
      endunless
    endif
    assign seo_description = page_description | default: settings.seo_description
  -%}
  <title>{{ seo_title }}</title>
  {%- if settings.favicon -%}
    <link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- else -%}
    <link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32" type="image/png">
    <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
  {%- endif %}
  <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
  {% render 'tf-seo', title: seo_title, description: seo_description %}

  {{ 'instrument-sans-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link visually-hidden" href="#main">Skip to content</a>
  {% render 'icon-sprite' %}
  {% sections 'header-group' %}
  <main id="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% render 'tf-catalog' %}
</body>
</html>
